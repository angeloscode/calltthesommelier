# База данных PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/sommelier?schema=public"

# Auth.js: секрет для подписи сессий (сгенерировать: npx auth secret)
AUTH_SECRET=""
# За прокси/на своём домене Auth.js должен доверять заголовку Host
AUTH_TRUST_HOST=true

# Первый администратор (создаётся командой npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Боевой домен: canonical, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL="https://example.com"

# Куда сохранять загруженные фото (вне public/)
UPLOAD_DIR="storage/uploads"
